<ui:FluentWindow x:Class="VpnClient.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Tunneled Apps"
        Height="540" Width="720"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Tunneled Apps" />

        <Grid Grid.Row="1" Margin="24,12,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button x:Name="AddAppBtn"
                           Content="Add app…"
                           Icon="{ui:SymbolIcon Add20}"
                           Appearance="Primary"
                           Click="AddAppBtn_Click" />
                <ui:TextBlock Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Select the .exe — child processes are tunneled automatically" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="0">
                <ListView x:Name="AppList" Background="Transparent" BorderThickness="0"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ui:TextBlock Text="{Binding DisplayName}" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="{Binding ExePath}"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  FontTypography="Caption"
                                                  Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="1"
                                           Content="Remove"
                                           Click="RemoveApp_Click"
                                           Tag="{Binding Id}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Close" Click="CloseBtn_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
